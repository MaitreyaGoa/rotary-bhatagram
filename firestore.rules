rules_version = '2';
// Paste into Firebase Console → Firestore Database → Rules → Publish.
// Admin login: rcbhatagram@gmail.com. To add more admins, add their emails to the list.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['rcbhatagram@gmail.com'];
    }

    // Public content: anyone can read, only admins can change
    match /{col}/{id} {
      allow read: if col in ['projects', 'events', 'gallery', 'members', 'settings', 'leaders', 'news'] || isAdmin();
      allow write: if isAdmin();
    }

    // Suggestion box: the public can only CREATE, never read others' entries
    match /suggestions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type','message','anonymous','name','contact','status','createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1500
        && request.resource.data.name.size() <= 80
        && request.resource.data.contact.size() <= 120
        && request.resource.data.status == 'new';
    }

    // Join requests: same idea
    match /joinRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','email','profession','interest','message','status','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'new';
    }
  }
}
